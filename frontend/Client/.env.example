# frontend/Client environment — used by next.config.mjs + SSR fetches.
# On cPanel set the same keys in "Setup Node.js App" → Environment
# Variables instead of creating this file on the server.
#
# Proxy/SSR target for the backend API (backend Node.js app origin):
API_ORIGIN=http://127.0.0.1:3030
# Proxy target for the admin panel app (its own Node.js app origin):
ADMIN_ORIGIN=http://127.0.0.1:3001
