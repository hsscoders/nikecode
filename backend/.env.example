# ============================================================
#  Backend environment — copy to backend/.env on the server and
#  fill in real values. NEVER commit the real .env to git.
# ============================================================

# Port — on cPanel (Setup Node.js App / Passenger) LEAVE THIS EMPTY:
# Passenger injects its own PORT and the app must use it.
# For local development set e.g. 3030.
PORT=

# MongoDB Atlas connection string (Database Access → user, Network
# Access → allow the cPanel server IP or 0.0.0.0/0)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/zapto?retryWrites=true&w=majority

# Secret used to sign user+admin JWTs — use a long random string
# (openssl rand -hex 32). ROTATE the old one: it was exposed in git history.
JWT_SECRET=

# Browser origins allowed to call this API (comma-separated, no trailing
# slash). Empty = allow all (fine for local dev, NOT for production).
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com
