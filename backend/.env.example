# ============================================================
# NIKECODE backend — MySQL edition
# Copy to backend/.env and fill in the real values.
# NEVER commit the real .env — it is gitignored.
# ============================================================

# ---- MySQL (application database) ----
# On cPanel hosting the app and MySQL usually share the server:
# prefer DB_HOST=localhost (socket) over the public IP, and make
# sure the MySQL user is allowed to connect from 127.0.0.1/localhost.
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nikecode
DB_USER=nikecode
DB_PASSWORD=CHANGE_ME_REAL_PASSWORD
# Connection pool (Passenger shared hosting: keep small)
DB_POOL_MAX=5
DB_POOL_MIN=0

# ---- Auth ----
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX

# ---- CORS (production: set your public origins, comma separated) ----
# Empty = allow all (development only — never in production!)
CORS_ORIGINS=

# ---- Server ----
# Do NOT set PORT on cPanel — Passenger injects it.
# PORT=3030

# ============================================================
# ONLY for the one-time data migration utility
# (backend/scripts/migrate-mongo-to-mysql.js) — the application
# itself never talks to MongoDB anymore. Remove after migrating.
# ============================================================
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=zapto
# MIGRATE_BATCH=500
